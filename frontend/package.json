{
  "name": "audux-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "build:browser-lite": "npm run typecheck && vite build --mode browser-lite",
    "build:backend": "node scripts/build-backend.mjs",
    "build:tauri": "npm run build:backend && npm run build",
    "preview": "vite preview",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:visual": "playwright test --config playwright.config.ts",
    "test:visual:update": "playwright test --config playwright.config.ts --update-snapshots"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.0",
    "@tauri-apps/plugin-updater": "2.13.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "i18next": "^26.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "^17.0.15",
    "typescript": "6.0.3",
    "vite": "8.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tauri-apps/cli": "2.12.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@vitest/coverage-v8": "^4.1.11",
    "jsdom": "^30.1.1",
    "vitest": "^4.1.10"
  }
}
