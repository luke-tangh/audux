{
  "name": "local-audio-library-frontend",
  "version": "0.5.0-beta.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "build:browser-lite": "npm run typecheck && vite build --mode browser-lite",
    "build:backend": "node scripts/build-backend.mjs",
    "build:tauri": "npm run build:backend && npm run build",
    "preview": "vite preview",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "test:visual": "playwright test --config playwright.config.ts",
    "test:visual:update": "playwright test --config playwright.config.ts --update-snapshots"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "typescript": "6.0.3",
    "vite": "8.1.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@tauri-apps/cli": "2.11.4"
  }
}
